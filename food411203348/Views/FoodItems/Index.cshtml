@model IEnumerable<food411203348.Models.FoodItem>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<!-- 💡 關鍵修改：用 d-flex 把新增按鈕跟搜尋框排在同一列，並分開左右 -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </div>

    <!-- 右側的搜尋表單 -->
    <form asp-controller="FoodItems" asp-action="Index" method="get" class="d-flex">
        <!-- 💡 修改 1：加上 value="@ViewData["CurrentFilter"]" 讓關鍵字留在框框裡 -->
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control me-2" placeholder="搜尋食物名稱..." />

        <!-- 💡 修改 2：加上 text-nowrap 讓「查詢」兩個字不會因為空間不夠被擠成兩行 -->
        <button type="submit" class="btn btn-outline-success text-nowrap">查詢</button>
    </form>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Calories)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Category.Name) <!-- 💡 關鍵修改：加上 .Name 顯示跨表資料 -->
                </td>
                <td>
                    @Html.DisplayFor(model => item.Price)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Calories)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Rating)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>